# Procela environment variables.
#
# Local dev: copy to .env, fill in any AI / Anthropic keys you want;
# the others can stay blank and the app will fall back to safe dev
# defaults (in-memory rate limiter, audit-log password resets, etc).
#
# Production: every var marked PROD-REQUIRED below MUST be set or
# the startup readiness check will warn in the log and a feature
# will silently degrade.

# ── Core ──
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
APP_URL=http://localhost:5173                # PROD-REQUIRED — used in reset-email links

# ── Database ──
DATABASE_URL=postgresql://procela:procela@localhost:5432/procela

# ── Auth provider ──
# dev | local | oidc | saml
AUTH_PROVIDER=dev
JWT_SECRET=change-me-in-production            # PROD-REQUIRED — sessions are forgeable with the default

# OIDC (Cognito / Microsoft / Okta)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# SAML (placeholder — not yet implemented)
SAML_ENTRY_POINT=
SAML_ISSUER=

# ── Local-credential policy ──
# Optional. Point at a custom HIBP-derived wordlist (one password per
# line, # comments allowed). Falls back to the bundled file when unset.
BREACHED_PASSWORDS_FILE=

# ── SCIM 2.0 provisioning ──
# Optional. Static bearer token that IdPs (Microsoft Entra, Okta)
# present when pushing user lifecycle events to /scim/v2/. Generate
# a long random string and paste the same value into both Procela's
# env and the IdP's SCIM provisioning config. When unset, every SCIM
# request returns 401.
SCIM_BEARER_TOKEN=

# ── At-rest encryption for TOTP / MFA secrets ──
# PROD-REQUIRED. The TOTP secret (HMAC key) has to be recoverable on
# every login so it can't be hashed; instead it's encrypted with
# AES-256-GCM. The key here is the master encryption key — the
# actual encryption key is derived via scrypt with a fixed salt.
# Generate a 32+ char random value; rotate by re-encrypting every
# record with a new key (out of scope for this prototype). When
# unset, secrets are stored in plaintext (dev only — production
# refuses to start with a warning).
MFA_ENCRYPTION_KEY=

# Cloud KMS providers (alternative to MFA_ENCRYPTION_KEY). Pick one:
#   KMS_PROVIDER=aws-kms     uses AWS KMS via @aws-sdk/client-kms
#   KMS_PROVIDER=azure-kv    uses Azure Key Vault via @azure/keyvault-keys
#                            + @azure/identity (RSA-OAEP-256)
#   KMS_PROVIDER=gcp-kms     uses GCP KMS via @google-cloud/kms
# The SDK is lazy-imported on first use — install only the one you pick.
KMS_PROVIDER=

# AWS KMS — required when KMS_PROVIDER=aws-kms
AWS_KMS_KEY_ID=
AWS_KMS_REGION=
# AWS credentials picked up via standard SDK chain (env, profile, instance role).

# Azure Key Vault — required when KMS_PROVIDER=azure-kv
AZURE_KEYVAULT_URL=
AZURE_KEYVAULT_KEY_NAME=
# Azure credentials picked up via DefaultAzureCredential (env, managed
# identity, az login). The key must be an asymmetric (RSA / EC) key.

# GCP KMS — required when KMS_PROVIDER=gcp-kms
GCP_KMS_KEY_RESOURCE=
# GOOGLE_APPLICATION_CREDENTIALS env var points to the service-account
# JSON; on GKE / Cloud Run the workload identity is picked up automatically.

# ── AI ──
ANTHROPIC_API_KEY=

# ── Storage ──
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
STORAGE_LOCAL_PATH=./storage

# ── Redis (rate limiter coordination) ──
# PROD-REQUIRED. When unset, the rate limiter degrades to per-instance
# in-memory counters and multi-instance brute-force protection is broken.
REDIS_URL=

# ── SMTP (transactional email — password resets, etc) ──
# All five PROD-REQUIRED. When any is missing, /auth/password/forgot
# falls back to writing the token to the audit log (dev mode) rather
# than delivering it to the user.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false                             # 'true' for port 465 implicit TLS
MAIL_FROM=Procela <noreply@procela.io>

# ── Logging ──
LOG_LEVEL=info

# ── Frontend ──
VITE_API_URL=http://localhost:3001/api/v1
