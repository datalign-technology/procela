# Procela evaluation stack — configuration.
# Copy this file to `.env` (same folder) before `docker compose up`:
#     cp .env.example .env
# Everything here has a working default for a local evaluation; the one line
# you SHOULD change is JWT_SECRET.

# ── Which images to pull ──────────────────────────────────────────────────
# Where the backend/frontend images live, and which tag to run. Pin PROCELA_TAG
# to a released version (e.g. 0.1.0) for a reproducible evaluation.
PROCELA_REGISTRY=ghcr.io/datalign-technology
PROCELA_TAG=latest

# ── Security ──────────────────────────────────────────────────────────────
# Signs session tokens (HS256 in the eval build). CHANGE THIS to any long
# random string, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Authentication provider. The evaluation build uses `dev`: sign-in is
# passwordless — enter any name/email on the login screen (or use the
# "Test Accounts" quick-login) and you're in. This is for evaluation only;
# a real deployment sets AUTH_PROVIDER=cognito | azuread | okta | saml.
AUTH_PROVIDER=dev

# ── Demo data ─────────────────────────────────────────────────────────────
# A demo tenant is loaded on first boot so the app isn't empty. Pick the
# industry fixture. One of: utilities | shipbuilding | healthcare |
# manufacturing | financial | government | logistics | insurance | telecom |
# education
DEMO_INDUSTRY=utilities

# ── AI features (optional) ────────────────────────────────────────────────
# Off by default so the stack runs with no external calls and no key. To try
# the AI assistant, template generation and suggestions, set ENABLED=true and
# provide a key for your chosen provider.
AI_FEATURES_ENABLED=false
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Storage ───────────────────────────────────────────────────────────────
# Local disk inside the backend container (exports / uploaded files). The
# default is fine for evaluation.
STORAGE_PROVIDER=local

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
