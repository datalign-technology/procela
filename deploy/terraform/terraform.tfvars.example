# Copy to terraform.tfvars and fill in the values. terraform.tfvars is
# .gitignored in this repo — never commit real ARNs / secrets.

region       = "us-east-1"
project_name = "procela"
environment  = "dev"

# Backend container image. Push the image (see packages/backend/Dockerfile)
# to your own ECR repo and paste the ref here.
app_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/procela-backend:latest"

# ACM cert for the ALB listener. Must be issued in var.region.
alb_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Public hostname CloudFront serves. Create the Route 53 alias yourself.
domain_name = "procela.example.com"

# ACM cert for CloudFront. MUST live in us-east-1. Leave null to fall back
# to the default *.cloudfront.net cert (useful for a first-plan smoke test).
cloudfront_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/11111111-1111-1111-1111-111111111111"

# Sizing knobs — reference defaults are fine for a demo.
db_instance_class = "db.t3.small"
desired_count     = 1

# ── Application config (non-secret) ──
# Empty values are fine for a first plan; set for a real deploy.
app_url              = "https://procela.example.com"
cors_allowed_origins = "" # extra browser origins, comma-separated
support_email        = "support@procela.ai" # in-app "Report a problem" inbox

# ── Authentication ──
# AUTH_PROVIDER: oidc | saml | local. Cognito is NOT a value — it federates
# via OIDC, so use auth_provider = "oidc" with the oidc_* fields + enable_oidc.
# "dev"/unrecognized values are rejected: the app treats an unrecognized
# provider as the insecure dev login (any email, no password) and refuses to
# boot in production, so Terraform validates this up front.
auth_provider = "oidc"

# OIDC non-secret config (used when enable_oidc = true; the client secret is
# the oidc_client_secret Secrets Manager entry). For Cognito, the issuer is
# https://cognito-idp.<region>.amazonaws.com/<user-pool-id>.
oidc_issuer    = ""
oidc_client_id = ""

# SAML non-secret config (used when enable_saml = true; the IdP signing cert is
# the saml_idp_cert secret).
saml_entry_point  = "" # IdP SSO URL
saml_issuer       = "" # SP entity id
saml_callback_url = "" # e.g. https://procela.example.com/api/v1/auth/saml/callback

# ── Optional features ──
# Flip a toggle to inject its secret into the ECS task. FIRST populate the
# secret out-of-band, e.g.:
#   aws secretsmanager put-secret-value \
#     --secret-id "$(terraform output -json secret_arns | jq -r .smtp_pass)" \
#     --secret-string '…'
# The MFA key + SCIM token are generated by Terraform; the rest are
# REPLACE_ME placeholders until you populate them.
enable_redis = true  # provisions ElastiCache + wires REDIS_URL automatically (default on)
enable_smtp  = false # SMTP_PASS + host/port/user/from below
enable_oidc  = false # OIDC_CLIENT_SECRET (AUTH_PROVIDER=oidc)
enable_saml  = false # SAML_IDP_CERT (AUTH_PROVIDER=saml)
enable_scim  = false # SCIM_BEARER_TOKEN — /scim/v2 endpoints

# SMTP non-secret config (used when enable_smtp = true). The SMTP_PASS
# secret is populated out-of-band (see above); these are the non-secret bits.
smtp_host   = ""
smtp_port   = 587
smtp_user   = ""
smtp_secure = false
mail_from   = "Procela <noreply@procela.io>"

# ── Resend (https://resend.com) — swap the SMTP block above for these ──
# The API key goes in the smtp_pass secret (not here). mail_from must be on a
# domain verified in Resend. Port 465 = implicit TLS; use 587 + smtp_secure =
# false for STARTTLS if 465 is blocked.
# smtp_host   = "smtp.resend.com"
# smtp_port   = 465
# smtp_user   = "resend"
# smtp_secure = true
# mail_from   = "Procela <noreply@procela.ai>"

# ── Production-hardening toggles ──
# These now DEFAULT ON, so a bare `terraform apply` gives a hardened stack:
# Multi-AZ RDS with deletion protection + Performance Insights, customer-managed
# KMS keys, VPC endpoints, per-AZ NAT, ALB restricted to CloudFront + invalid-
# header dropping, WAF on CloudFront, access logs, and CloudWatch alarms. Redis
# is provisioned (enable_redis above). Set alarm_email to receive alerts:
# alarm_email = "ops@procela.example.com"
#
# ALWAYS `terraform plan` and review — several of these force resource
# replacement or re-encryption on an existing stack.
#
# --- Cheap dev/minimal stack: paste this block to turn the cost-bearing
#     defaults OFF (single-AZ, shared NAT, AWS-managed keys, no WAF/PI/alarms):
# rds_multi_az                   = false
# rds_deletion_protection        = false
# rds_performance_insights       = false
# enable_kms_cmk                 = false
# enable_vpc_endpoints           = false
# enable_nat_per_az              = false
# enable_waf                     = false
# enable_access_logs             = false
# enable_monitoring_alarms       = false
# redis_num_nodes                = 1        # single-node cache (no HA)
# db_backup_retention_days       = 7
#
# --- Redis sizing (defaults: 2 nodes, cache.t4g.micro, TLS + AUTH on)
# redis_node_type          = "cache.t4g.micro"
# redis_num_nodes          = 2
# redis_transit_encryption = true
#
# --- ECS autoscaling — OPT-IN. Scales backend tasks on CPU (+ optional ALB
#     requests/target). Size max_tasks against RDS max_connections: max_tasks x
#     the Prisma pool must stay under it (or front RDS with RDS Proxy). Turning
#     this on forces at least autoscaling_min_tasks running.
# enable_autoscaling                 = true
# autoscaling_min_tasks              = 2
# autoscaling_max_tasks              = 6
# autoscaling_cpu_target             = 60
# autoscaling_enable_request_scaling = true
# autoscaling_request_target         = 1000   # ALB requests / task / minute
#
# --- DB secret rotation — OPT-IN (deploy the AWS SAR Postgres rotation Lambda first)
# enable_db_secret_rotation = true
# db_rotation_lambda_arn    = "arn:aws:lambda:us-east-1:123456789012:function:SecretsManagerRDSPostgreSQLRotation"
# db_rotation_days          = 30
#
# --- Account-level security services — OPT-IN (left OFF by default because
#     they're commonly org-managed and conflict-prone: AWS Config allows only
#     ONE configuration recorder per region, so enabling it on an account that
#     already has Config will FAIL the apply. Enable only where this stack owns
#     the account's security baseline).
# enable_cloudtrail   = true
# enable_guardduty    = true
# enable_security_hub = true
# enable_config       = true
